# 시크릿 — 절대 커밋하지 않는다.
.env
.env.local
backend/backend/.env
frontend/.env
frontend/.env.local
!.env.example
!**/.env.example

node_modules/
__pycache__/
*.pyc

.idea/
*.log

# 빌드 산출물 - 배포 이미지(frontend/Dockerfile)가 직접 빌드한다. 커밋하면 빌드마다 변경이 생긴다.
frontend/dist/

# Android (Capacitor) 빌드 산출물·로컬 설정
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/
*.apk
*.aab

# 앱 서명 키 - 절대 커밋하지 않는다. 잃거나 새면 같은 앱으로 업데이트를 못 올린다.
*.jks
*.keystore
keystore.properties

# 배포용 APK 한 개만 예외로 올린다. 서버가 git pull 로 받아 /srv/downloads 로 마운트한다.
# (위 *.apk 규칙보다 뒤에 있어야 예외가 먹는다. 빌드 산출물 APK 는 계속 제외)
!downloads/parkingdesk.apk
