# Django 런타임 설정. 이 파일을 .env 로 복사해서 실제 값을 채운다.
# .env 는 커밋되지 않는다(루트 .gitignore).

# ---------------------------------------------------------------- Django
# 필수. 기본값이 없어서 비어 있으면 앱이 기동하지 않는다.
# 생성:
#   docker run --rm python:3.11-slim python -c \
#     "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 운영에서는 반드시 False. True 로 두면 DRF 권한이 AllowAny 로 바뀌어
# API 전체가 무인증으로 열린다.
DJANGO_DEBUG=False

# 서비스할 호스트. 콤마로 구분한다.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DEBUG=False 에서 admin 로그인 등 POST 를 받으려면 scheme 까지 적는다.
# 예) http://localhost:5174,http://your-host:5174
DJANGO_CSRF_TRUSTED_ORIGINS=

# 프론트를 nginx 프록시로 쓰면 비워둔다. Vite 를 따로 띄울 때만 채운다.
# 예) http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=

# https 로 전환한 뒤에 True 로 바꾼다. http 로 서비스하는 동안 켜면
# 쿠키가 전송되지 않아 로그인이 되지 않는다.
DJANGO_SECURE_COOKIES=False

# ---------------------------------------------------------------- Database
# dev | staging | prod 중 하나. 미지정이면 dev.
ACTIVE_DB=dev

DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_HOST=
DEV_DB_PORT=5432

STAGING_DB_NAME=
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_HOST=
STAGING_DB_PORT=5432

PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_HOST=
PROD_DB_PORT=5432
