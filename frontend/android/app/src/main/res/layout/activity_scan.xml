<?xml version="1.0" encoding="utf-8"?>
<!-- 번호판 인식 화면 (ScanActivity).
     위: 닫기(왼쪽) / 플래시(오른쪽). 가운데: 가이드 박스(안내·진행 문구는 PlateGuideView 가 직접 그림).
     아래: 직접 입력. 위아래 여백은 상태바·내비게이션 바 높이만큼 코드에서 더한다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.parkingdesk.app.plate.PlateGuideView
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_scan_circle"
            android:contentDescription="닫기"
            android:src="@drawable/ic_close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/torch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_scan_circle"
                android:contentDescription="플래시 켜기"
                android:src="@drawable/ic_flash_off"
                android:visibility="gone" />

            <TextView
                android:id="@+id/torch_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_scan_badge"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="자동"
                android:textColor="#FF071A3A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/manual"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_scan_pill"
            android:drawableStart="@drawable/ic_keyboard"
            android:drawablePadding="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="직접 입력"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
