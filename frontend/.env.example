# Mock mode: run the whole app with in-memory demo data, no backend needed.
# 1 = on (any login works, seed data loaded), empty/0 = off (real backend).
VITE_MOCK=

# Base origin of the Django backend.
# Leave EMPTY to use same-origin (recommended — nginx/Vite proxy /api & /users).
# Set to an absolute URL only if the backend is on a different host, e.g.:
#   VITE_API_BASE=http://localhost:8000
VITE_API_BASE=
