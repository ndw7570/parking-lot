# 컴포즈 레벨 설정. 이 파일을 .env 로 복사해서 쓴다.
#   cp .env.example .env
#
# 이 파일은 compose 가 ${VAR} 치환에만 쓴다. 컨테이너 안으로 들어가지 않는다.
# 전부 기본값이 있으므로 파일이 없어도 뜬다.
#
# Django 런타임 설정(시크릿, DB, DEBUG)은 여기가 아니라
# backend/.env 에 있다. backend/.env.example 참고.

# 호스트에 노출할 포트
FRONTEND_PORT=5173
BACKEND_PORT=5174

# gunicorn 워커 수. 보통 (CPU 코어 x 2) + 1 로 잡는다.
GUNICORN_WORKERS=3

# 프론트 번들에 박히는 API 주소. 비워두면 same-origin 이고 nginx 가 프록시한다.
# 백엔드가 다른 호스트에 있을 때만 절대 URL 을 넣는다.
VITE_API_BASE=

# 이미지 태그. 롤백할 일이 있으면 버전을 박아 쓴다.
IMAGE_TAG=latest
